#include <stdio.h>

void activitySelection(int start[], int finish[], int n)
{
    int i, j, temp;
    int activity[10];

    // Store original activity numbers
    for (i = 0; i < n; i++)
    {
        activity[i] = i + 1;
    }

    // Sort activities by finish time
    for (i = 0; i < n - 1; i++)
    {
        for (j = 0; j < n - i - 1; j++)
        {
            if (finish[j] > finish[j + 1])
            {
                temp = finish[j];
                finish[j] = finish[j + 1];
                finish[j + 1] = temp;

                temp = start[j];
                start[j] = start[j + 1];
                start[j + 1] = temp;

                temp = activity[j];
                activity[j] = activity[j + 1];
                activity[j + 1] = temp;
            }
        }
    }

    // Select the first activity
    int lastFinish = finish[0];

    printf("Selected activities: A%d ", activity[0]);

    // Select compatible activities
    for (i = 1; i < n; i++)
    {
        if (start[i] >= lastFinish)
        {
            printf("A%d ", activity[i]);
            lastFinish = finish[i];
        }
    }

    printf("\n");
}

int main()
{
    int start[] = {1, 2, 3, 4, 7, 8, 9, 9, 11, 12};
    int finish[] = {3, 5, 4, 7, 10, 9, 11, 13, 12, 14};

    int n = sizeof(start) / sizeof(start[0]);

    activitySelection(start, finish, n);

    return 0;
}
